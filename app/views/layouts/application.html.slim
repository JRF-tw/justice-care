doctype html
html lang="zh-Hant-TW" 
  head
    meta charset="utf-8" /
    meta content="width=device-width, initial-scale=1" name="viewport"
    meta name="google-site-verification" content="dSbDkPu-r2DhrapQYIt8kHyn3KD38iuTyTm8WQbb8VI"
    link href="#{image_path('logo.png')}" rel="shortcut icon"
    = stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track' => true
    = csrf_meta_tags
    = display_meta_tags(default_meta_tags)
    = site_structured_data_tags
    = yield :structured_data
  body
    /! 內容
    /! 佈告欄
    = render 'layouts/header'
    = yield
    = render 'layouts/footer'
    = render 'layouts/login_menu'
    = debug(params) if Rails.env.development?
    = javascript_include_tag 'application', 'data-turbolinks-track' => true
    noscript
      iframe height="0" src="//www.googletagmanager.com/ns.html?id=#{Setting.google_gtm.id}" style="display:none;visibility:hidden" width="0" 