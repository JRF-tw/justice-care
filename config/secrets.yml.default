# Be sure to restart your server when you modify this file.
#
# Copy this file to config/secrets.yml (which is gitignored) and fill in your own
# values. Generate a secret with `bin/rails secret`.
#
# Make sure the secrets in config/secrets.yml are kept private and are never
# committed to version control.

development:
  secret_key_base: GENERATE_WITH_bin_rails_secret

test:
  secret_key_base: GENERATE_WITH_bin_rails_secret

# Do not keep production secrets in the repository,
# instead read values from the environment.
production:
  secret_key_base: <%= ENV["SECRET_KEY_BASE"] %>
